{
  "manifest_version": 3,
  "name": "Bilibili Content Filter",
  "version": "1.0.0",
  "description": "Filter distracting content on Bilibili.com to maintain focus while browsing",
  
  "permissions": [
    "storage",
    "activeTab"
  ],
  
  "host_permissions": [
    "*://*.bilibili.com/*"
  ],
  
  "content_scripts": [
    {
      "matches": ["*://*.bilibili.com/*"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_start"
    }
  ],
  
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Bilibili Content Filter",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  
  "web_accessible_resources": [
    {
      "resources": ["content/*"],
      "matches": ["*://*.bilibili.com/*"]
    }
  ]
}